---
type Props = {
    title?: string;
    description?: string;
};

const {
    title = "Masjidul | My Portfolio",
    description = "Portfolio website built with Astro",
} = Astro.props;

import "../styles/global.css";
import "aos/dist/aos.css";
import Navbar from "../components/navbar/Navbar.svelte";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    </head>

    <body class="min-h-screen bg-[#F4F2EE] flex flex-col">
        <header class="sticky top-0 z-50 bg-white border-[#EBEBEB]">
            <Navbar client:load />
        </header>

        <main class="relative w-full max-w-480 mx-auto">
            <!-- Vertical border lines aligned to the locked container edges at every screen size -->
            <div
                class="hidden lg:block absolute top-0 bottom-0 w-0.5 bg-white pointer-events-none z-40"
                style="left: max(var(--wrap-pad), calc((100% - var(--wrap-max)) / 2));"
            >
            </div>
            <div
                class="hidden lg:block absolute top-0 bottom-0 w-0.5 bg-white pointer-events-none z-40"
                style="right: max(var(--wrap-pad), calc((100% - var(--wrap-max)) / 2));"
            >
            </div>

            <slot />
        </main>

        <script>
            import AOS from "aos";

            AOS.init({
                duration: 800,
                easing: "ease-out-cubic",
                once: false,
                mirror: true,
                offset: 80,
            });
        </script>
    </body>
</html>
