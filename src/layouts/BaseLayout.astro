---
type Props = {
    title?: string;
    description?: string;
};

const {
    title = "Masjidul | My Portfolio",
    description = "Portfolio website built with Astro",
} = Astro.props;

import "../styles/global.css";
import Navbar from "../components/navbar/Navbar.svelte";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    </head>

    <body class="min-h-screen bg-[#F4F2EE] flex flex-col">
        <header class="sticky top-0 z-50 bg-white border-[#EBEBEB]">
            <Navbar client:load />
        </header>

        <main class="relative w-full max-w-480 mx-auto">
            <!-- Vertical border lines aligned to the locked container edges at every screen size -->
            <div
                class="hidden xl:block absolute top-0 bottom-0 w-0.5 bg-white pointer-events-none z-40"
                style="left: max(var(--wrap-pad), calc((100% - var(--wrap-rail)) / 2));"
            >
            </div>
            <div
                class="hidden xl:block absolute top-0 bottom-0 w-0.5 bg-white pointer-events-none z-40"
                style="right: max(var(--wrap-pad), calc((100% - var(--wrap-rail)) / 2));"
            >
            </div>

            <slot />
        </main>

        <script>
            // Lightweight scroll-reveal. Reads the existing data-aos / data-aos-delay
            // / data-aos-duration attributes, so no markup changes are needed.
            // IntersectionObserver-based: no position math, no race conditions.
            (() => {
                const els = Array.from(
                    document.querySelectorAll("[data-aos]"),
                );
                if (!els.length) return;

                const wantsMotion = window.matchMedia(
                    "(prefers-reduced-motion: no-preference)",
                ).matches;
                if (!wantsMotion) return; // leave everything visible, no animation

                // Only now do we let the CSS hide things — so if this script
                // never runs, content is never stuck invisible.
                document.documentElement.classList.add("reveal-on");

                for (const el of els) {
                    const delay = el.getAttribute("data-aos-delay");
                    const dur = el.getAttribute("data-aos-duration");
                    if (delay) el.style.setProperty("--reveal-delay", delay + "ms");
                    if (dur) el.style.setProperty("--reveal-dur", dur + "ms");
                }

                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.isIntersecting) {
                                e.target.classList.add("reveal-in");
                            } else {
                                // re-arm only after the element has fully left
                                // the viewport (never hide something on screen)
                                e.target.classList.remove("reveal-in");
                            }
                        }
                    },
                    { threshold: 0.08, rootMargin: "0px 0px -8% 0px" },
                );

                for (const el of els) io.observe(el);
            })();
        </script>
    </body>
</html>
