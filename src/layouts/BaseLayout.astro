---
type Props = {
    title?: string;
    description?: string;
};

const {
    title = "Masjidul | My Portfolio",
    description = "Portfolio website built with Astro",
} = Astro.props;

import "../styles/global.css";
import Navbar from "../components/navbar/Navbar.svelte";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    </head>

    <body class="min-h-screen bg-[#F4F2EE] flex flex-col">
        <!-- Figma vertical border lines: 2px white, at x=356 (left) and x=1562 (right) on 1920px canvas -->
        <div
            class="hidden 2xl:block fixed top-0 bottom-0 left-89 w-0.5 bg-white pointer-events-none z-40"
        >
        </div>
        <div
            class="hidden 2xl:block fixed top-0 bottom-0 right-89 w-0.5 bg-white pointer-events-none z-40"
        >
        </div>

        <header class="sticky top-0 z-50 bg-white border-b border-[#EBEBEB]">
            <Navbar client:load />
        </header>

        <main class="w-full">
            <slot />
        </main>
    </body>
</html>
