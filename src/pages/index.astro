---
import Footer from "../components/footer/Footer.astro";
import About from "../components/home/About.astro";
import Banner from "../components/home/Banner.astro";
import Contact from "../components/home/Contact.astro";
import Faq from "../components/home/Faq2.astro";
import LatestProject from "../components/home/LatestProject.astro";
import Team from "../components/home/Team.astro";
import TrustedBy from "../components/home/TrustedBy.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProvideService from "../components/home/ProvideService.astro";
import Benefits from "../components/home/Benefits.astro";
import Impact from "../components/home/Impact.astro";
import LogoBanner from "../components/home/LogoBanner.astro";
import Growth from "../components/home/Growth.astro";
---

<BaseLayout>
	<div
		class="border-b-2 border-[#FFFFFF]"
		data-aos="fade-down"
		data-aos-duration="1000"
	>
		<Banner />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-up">
		<TrustedBy />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-right">
		<LatestProject />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-left">
		<ProvideService />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="zoom-in">
		<Benefits />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-up">
		<Impact />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-right">
		<About />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="zoom-in-up">
		<Team />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-left">
		<Growth />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-up">
		<Faq />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="zoom-in">
		<Contact />
	</div>
	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-up">
		<LogoBanner />
	</div>

	<div class="border-b-2 border-[#FFFFFF]" data-aos="fade-up">
		<Footer />
	</div>
	<div class="border-b-2 border-[#FFFFFF]">
		<div class="pt-5">
			<p
				class="text-center text-[18px] font-normal leading-[23.4px] text-[#4E5663]"
			>
				Developed By &copy; <a
					href="https://safayet.vercel.app"
					target="_blank"
					rel="noopener noreferrer"
					class="text-[#1A1A1A] hover:text-[#2966F4] transition-colors"
					>Safayet Hossain Arif</a
				>
			</p>
		</div>
	</div>
</BaseLayout>
