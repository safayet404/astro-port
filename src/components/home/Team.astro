---
const members = [
    { id: 1, image: "/t1.png", name: "Safyet Hosain" },
    { id: 2, image: "/t2.png", name: "Nazrul Islam" },
    { id: 3, image: "/t3.png", name: "Naznin Akter" },
    { id: 4, image: "/t1.png", name: "Masjidul Islam" },
];
---

<!-- TEAM: 1920x517 | VERTICAL gap:40 | pad T:50 R:370 B:50 L:370 | align:CENTER -->
<section class="w-full py-[50px] px-6 2xl:px-[370px] flex flex-col items-center gap-10">

    <!-- Header: VERTICAL gap:10 | centered -->
    <div class="flex flex-col items-center gap-[10px] text-center">
        <!-- Badge: stroke:#BDC1C7 1px | Geist 16px/500 #4E5663 | radius:100 -->
        <div class="inline-flex border border-[#BDC1C7] rounded-full py-[10px] px-4">
            <span class="text-[16px] font-medium leading-[20.8px] text-[#4E5663]">Our Team</span>
        </div>
        <!-- Geist 50px/700 #1A1A1A lh:54 ls:-2 -->
        <h2 class="text-[36px] lg:text-[50px] font-bold leading-[1.08] lg:leading-[54px] tracking-[-2px] text-[#1A1A1A]">Meet Expert Team</h2>
    </div>

    <!-- 4-column grid: HORIZONTAL gap:16 | 1180x283 -->
    <div class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4">
        {members.map((member, i) => (
            <div class="relative bg-white p-[10px] rounded-[10px]">
                <!-- Image: 263x263 radius:10 -->
                <div class="w-full aspect-square rounded-[10px] overflow-hidden bg-gray-100">
                    <img
                        src={member.image}
                        alt={member.name}
                        class="w-full h-full object-cover"
                    />
                </div>
                <!-- Name label (shown on 3rd card per Figma) -->
                {i === 2 && (
                    <div class="absolute bottom-[15px] left-1/2 -translate-x-1/2 bg-white p-[5px] rounded-[10px]">
                        <div class="bg-[#1A1A1A] rounded-full py-[10px] px-5 whitespace-nowrap">
                            <!-- Geist 18px/600 #FFFFFF lh:23.4 -->
                            <span class="text-[18px] font-semibold leading-[23.4px] text-white">{member.name}</span>
                        </div>
                    </div>
                )}
            </div>
        ))}
    </div>
</section>

<!-- CTA Banner: Frame 2147259544 | 1180x256 | bg:#FFFFFF pad:16 -->
<div class="w-full px-6 2xl:px-[370px] py-0">
    <div class="w-full bg-white p-4 rounded-[10px]">
        <!-- Inner dark: HORIZONTAL gap:178 | pad T:40 R:40 B:40 L:40 | bg:#1A1A1A | radius:10 | SPACE_BETWEEN align:CENTER -->
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 bg-[#1A1A1A] rounded-[10px] p-10">
            <!-- Heading: Geist font #FFFFFF -->
            <h2 class="text-[28px] lg:text-[36px] font-semibold text-white leading-tight">
                Ready To Grow Your<br />Business Digitally?
            </h2>
            <!-- CTA button -->
            <a
                href="#contact"
                class="inline-flex items-center gap-2 bg-[#2966F4] text-white rounded-full py-[10px] px-5 text-[18px] font-medium hover:bg-[#1d50d4] transition-colors shrink-0"
            >
                Book a Call
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M7 17L17 7M17 7H7M17 7V17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>
</div>
