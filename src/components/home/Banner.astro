---
import { Image } from "astro:assets";
import me from "../../assets/me2.png";
---

<!-- BANNER: 1920x628 | HORIZONTAL gap:127 | pad T:50 R:370 B:50 L:370 | justify:SPACE_BETWEEN align:CENTER -->
<section class="w-full py-12.5 px-6 2xl:px-92.5">
    <div
        class="flex flex-col lg:flex-row items-center justify-between gap-31.75"
    >
        <!-- Left: VERTICAL gap:32 -->
        <div class="flex flex-col gap-8 max-w-171" data-aos="fade-right" data-aos-duration="900">
            <!-- Inner: VERTICAL gap:20 -->
            <div class="flex flex-col gap-5">
                <!-- Badge: 253x36 | pad T:10 R:16 B:10 L:16 | radius:100 | stroke:#BDC1C7 1px -->
                <div
                    class="inline-flex items-center gap-2 self-start border border-[#BDC1C7] rounded-full py-2.5 px-4"
                >
                    <!-- Green dot 8x8 #47C554 -->
                    <span class="w-2 h-2 rounded-full bg-[#47C554] shrink-0"
                    ></span>
                    <!-- Geist 18px/500 #4E5663 -->
                    <span
                        class="text-[18px] font-medium leading-none text-[#4E5663]"
                        >Available for new project</span
                    >
                </div>

                <!-- Heading: Geist 64px/600 #1A1A1A lh:74 ls:-3 -->
                <h1
                    class="text-[48px] capitalize lg:text-[54px] font-semibold leading-[1.15] lg:leading-18.5 tracking-[-3px] text-[#1A1A1A]"
                >
                    We design<br />to drive results &amp;<br />faster business
                    growth.
                </h1>

                <!-- Subtext: Geist 20px/500 #4E5663 lh:26 -->
                <p
                    class="text-[20px] capitalize font-medium leading-6.5 text-[#4E5663] max-w-170"
                >
                    I have worked with over 50+ clients and 16+ brands trusted
                    by 1.3M+ customers worldwide to help them achieve their
                    goals.
                </p>
            </div>

            <!-- CTA Button: HORIZONTAL gap:6 | pad T:10 R:20 B:10 L:20 | radius:100 | bg:#2966F4 -->
            <a
                href="#contact"
                class="inline-flex items-center gap-1.5 w-96.5 h-16 shadow-black shadow-2xl justify-center bg-[#2966F4] text-white rounded-full py-2.5 px-5 hover:bg-[#1d50d4] transition-colors"
            >
                <!-- Geist 22px/500 #FFFFFF lh:28.6 -->
                <span class="text-[22px] font-medium leading-[28.6px]"
                    >Book a Call</span
                >
                <!-- Arrow icon 26x26 -->
                <!-- <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                    <path d="M6 20L20 6M20 6H6M20 6V20" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg> -->

                <svg
                    width="26"
                    height="26"
                    viewBox="0 0 26 26"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <g clip-path="url(#clip0_1_39)">
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M19.6947 4.7735C19.6977 4.77044 19.7009 4.7673 19.704 4.76424L21.2361 6.29638L21.2041 6.3284C17.5456 10.0171 17.7315 15.0483 20.087 17.4038L18.5549 18.9358C16.6397 17.0207 15.8666 14.127 16.3457 11.1868L6.29846 21.234L4.7664 19.7019L14.8138 9.65459C11.8735 10.1337 8.97959 9.36052 7.06442 7.44535L8.59648 5.91328C10.9568 8.27357 16.004 8.45544 19.6947 4.7735Z"
                            fill="white"></path>
                    </g>
                    <defs>
                        <clipPath id="clip0_1_39">
                            <rect width="26" height="26" fill="white"></rect>
                        </clipPath>
                    </defs>
                </svg>
            </a>
        </div>

        <!-- Right: Image placeholder 432x528 radius:10 -->
        <div class="hidden lg:block shrink-0" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <Image
                src={me}
                alt="Masjidul"
                width={432}
                height={528}
                class="rounded-[10px] object-cover"
                style="width:432px; height:528px;"
            />
        </div>
    </div>
</section>
