---
import { Image } from "astro:assets";
import me from "../../assets/me.png";
---

<!-- BANNER: 1920x628 | HORIZONTAL gap:127 | pad T:50 R:370 B:50 L:370 | justify:SPACE_BETWEEN align:CENTER -->
<section class="w-full py-[50px] px-6 2xl:px-[370px]">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-[127px]">

        <!-- Left: VERTICAL gap:32 -->
        <div class="flex flex-col gap-8 max-w-[684px]">

            <!-- Inner: VERTICAL gap:20 -->
            <div class="flex flex-col gap-5">

                <!-- Badge: 253x36 | pad T:10 R:16 B:10 L:16 | radius:100 | stroke:#BDC1C7 1px -->
                <div class="inline-flex items-center gap-1 self-start border border-[#BDC1C7] rounded-full py-[10px] px-4">
                    <!-- Green dot 8x8 #47C554 -->
                    <span class="w-2 h-2 rounded-full bg-[#47C554] shrink-0"></span>
                    <!-- Geist 18px/500 #4E5663 -->
                    <span class="text-[18px] font-medium leading-[23.4px] text-[#4E5663]">Available for new project</span>
                </div>

                <!-- Heading: Geist 64px/600 #1A1A1A lh:74 ls:-3 -->
                <h1 class="text-[48px] lg:text-[64px] font-semibold leading-[1.15] lg:leading-[74px] tracking-[-3px] text-[#1A1A1A]">
                    We design<br />to drive results &amp;<br />faster business growth.
                </h1>

                <!-- Subtext: Geist 20px/500 #4E5663 lh:26 -->
                <p class="text-[20px] font-medium leading-[26px] text-[#4E5663] max-w-[680px]">
                    I have worked with over 50+ clients and 16+ brands trusted by 1.3M+
                    customers worldwide to help them achieve their goals.
                </p>
            </div>

            <!-- CTA Button: HORIZONTAL gap:6 | pad T:10 R:20 B:10 L:20 | radius:100 | bg:#2966F4 -->
            <a
                href="#contact"
                class="inline-flex items-center gap-[6px] self-start bg-[#2966F4] text-white rounded-full py-[10px] px-5 hover:bg-[#1d50d4] transition-colors"
                style="height:64px;"
            >
                <!-- Geist 22px/500 #FFFFFF lh:28.6 -->
                <span class="text-[22px] font-medium leading-[28.6px]">Book a Call</span>
                <!-- Arrow icon 26x26 -->
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                    <path d="M6 20L20 6M20 6H6M20 6V20" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>

        <!-- Right: Image placeholder 432x528 radius:10 -->
        <div class="hidden lg:block shrink-0">
            <Image
                src={me}
                alt="Masjidul"
                width={432}
                height={528}
                class="rounded-[10px] object-cover"
                style="width:432px; height:528px;"
            />
        </div>
    </div>
</section>
