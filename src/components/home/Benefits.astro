---
const benefits = [
    { label: "Conversion Guaranteed" },
    { label: "Top-notch Quality" },
    { label: "Lightning Fast Delivery" },
    { label: "Fixed Price, No Hidden Cost" },
    { label: "Unlimited Revisions" },
    { label: "Backed by Super Skilled Team" },
];
---

<!-- BENEFITS: 1920x490 | VERTICAL gap:10 | pad T:50 R:370 B:50 L:370 -->
<section id="benefits" class="w-full py-[50px] px-6 2xl:px-[370px] flex flex-col gap-[10px]">

    <!-- Outer white card: 1180x390 | bg:#FFFFFF | pad 16 -->
    <div class="w-full bg-white p-4 rounded-[10px]">

        <!-- Inner dark card: HORIZONTAL gap:20 | pad T:32 R:20 B:32 L:20 | radius:10 | bg:#1A1A1A | SPACE_BETWEEN align:CENTER -->
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5 bg-[#1A1A1A] rounded-[10px] py-8 px-5">

            <!-- Left: 400x254 | VERTICAL gap:36 -->
            <div class="flex flex-col gap-9 max-w-[400px]">

                <!-- Badge: stroke:#4E5663 1px | Geist 16px/500 #FFFFFF | pad T:10 R:16 B:10 L:16 | radius:100 -->
                <div class="inline-flex self-start border border-[#4E5663] rounded-full py-[10px] px-4">
                    <span class="text-[16px] font-medium leading-[20.8px] text-white">Why Chose Masjidul Team</span>
                </div>

                <!-- Heading: Geist 50px/700 #FFFFFF lh:54 ls:-2 -->
                <h2 class="text-[36px] lg:text-[50px] font-bold leading-[1.08] lg:leading-[54px] tracking-[-2px] text-white">
                    Benefits of working with us
                </h2>

                <!-- Button: 342x64 | bg:#2966F4 | stroke:#1A1A1A 1px | radius:100 | pad T:10 R:20 B:10 L:20 -->
                <a
                    href="#contact"
                    class="inline-flex items-center gap-[6px] self-start bg-[#2966F4] border border-[#1A1A1A] text-white rounded-full py-[10px] px-5 hover:bg-[#1d50d4] transition-colors"
                    style="height:64px;"
                >
                    <!-- Geist 22px/500 #FFFFFF lh:28.6 -->
                    <span class="text-[22px] font-medium leading-[28.6px]">Book a 15 min into Call</span>
                    <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                        <path d="M6 20L20 6M20 6H6M20 6V20" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>

            <!-- Right: 658x257 | VERTICAL gap:40 -->
            <div class="flex flex-col gap-10 max-w-[658px]">

                <!-- Description: Geist 22px/500 #D1D1D1 lh:30 ls:-0.5 -->
                <p class="text-[22px] font-medium leading-[30px] tracking-[-0.5px] text-[#D1D1D1]">
                    I don't just design for screens I design for business growth. Mention conversion rates,
                    user retention, and aligning design with business goals.
                </p>

                <!-- Benefits grid: HORIZONTAL gap:32 | 2 columns -->
                <div class="flex flex-col sm:flex-row gap-8">
                    <!-- Left column -->
                    <div class="flex flex-col gap-5">
                        {benefits.slice(0, 3).map((b) => (
                            <div class="flex items-center gap-2">
                                <!-- Icon 24x24 -->
                                <div class="w-6 h-6 flex items-center justify-center shrink-0">
                                    <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
                                        <path d="M1 6L6 11L15 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <!-- Geist 22px/500 #FFFFFF lh:28.6 ls:-0.5 -->
                                <span class="text-[22px] font-medium leading-[28.6px] tracking-[-0.5px] text-white">{b.label}</span>
                            </div>
                        ))}
                    </div>
                    <!-- Right column -->
                    <div class="flex flex-col gap-5">
                        {benefits.slice(3).map((b) => (
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 flex items-center justify-center shrink-0">
                                    <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
                                        <path d="M1 6L6 11L15 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <span class="text-[22px] font-medium leading-[28.6px] tracking-[-0.5px] text-white">{b.label}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
