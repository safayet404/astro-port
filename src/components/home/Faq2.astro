---
const faqs = [
    {
        question: "What makes your UI/UX and web design different?",
        answer: "I focus on user-friendly, modern, and business-driven design. Every design I create is clean, easy to use, and built to help you get more users, leads, or sales, not just look good.",
        open: true,
    },
    {
        question: "Do you create fully custom website designs?",
        answer: "Yes, every pixel is crafted from scratch to align with your brand identity and business goals, ensuring a unique digital presence.",
        open: false,
    },
    {
        question: "Will my website be mobile-friendly and responsive?",
        answer: "Absolutely. I follow a mobile-first philosophy so your site works seamlessly on phones, tablets, and large desktop screens.",
        open: false,
    },
    {
        question: "Can you redesign my existing website?",
        answer: "Yes, I can audit your current site and perform a full strategic redesign to improve conversion rates and user experience.",
        open: false,
    },
    {
        question: "Do you design e-commerce websites?",
        answer: "I specialize in conversion-optimized e-commerce layouts for platforms like Shopify and custom builds, focusing on the buyer's journey.",
        open: false,
    },
    {
        question: "How long does it take to design a website?",
        answer: "A standard landing page takes about 1–2 weeks, while a full multi-page website typically takes 3–5 weeks depending on complexity.",
        open: false,
    },
];
---

<!-- FAQ: 1920x782 | HORIZONTAL SPACE_BETWEEN | pad T:50 R:370 B:50 L:370 -->
<section id="faq" class="w-full py-[50px] px-6 2xl:px-[370px] flex flex-col lg:flex-row items-start justify-between gap-10">

    <!-- Left col: 396x352 | VERTICAL SPACE_BETWEEN | gap:62 -->
    <div class="flex flex-col justify-between gap-10 lg:gap-[62px] w-full lg:w-[396px] shrink-0">

        <div class="flex flex-col gap-[10px]">
            <!-- Badge: stroke:#BDC1C7 1px | Geist 16px/500 #4E5663 | radius:100 -->
            <div class="inline-flex self-start border border-[#BDC1C7] rounded-full py-[10px] px-4">
                <span class="text-[16px] font-medium leading-[20.8px] text-[#4E5663]">FAQ,s</span>
            </div>
            <!-- Heading: Geist 50px/700 #1A1A1A lh:54 ls:-2 -->
            <h2 class="text-[36px] lg:text-[50px] font-bold leading-[1.08] lg:leading-[54px] tracking-[-2px] text-[#1A1A1A]">
                Frequently Asked Questions
            </h2>
            <!-- Subtext: Geist 20px/500 #4E5663 lh:26 ls:-0.5 -->
            <p class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-[#4E5663]">You have more questions !</p>
        </div>

        <!-- CTA: 323x64 | bg:#2966F4 | stroke:#1A1A1A | radius:100 -->
        <a
            href="https://wa.me/8801875189361"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-[10px] self-start bg-[#2966F4] text-white rounded-full py-[10px] px-5 hover:bg-[#1d50d4] transition-colors"
            style="height:64px; box-shadow: 0px 12px 20px rgba(26,26,26,0.25), inset 0 0 16px rgba(0,37,123,0.25);"
        >
            <span class="text-[22px] font-medium leading-[28.6px]">Ask Question</span>
            <svg width="30" height="30" viewBox="0 0 30 30" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M21.84 17.98c-.37-.19-2.2-1.08-2.54-1.21-.34-.12-.59-.19-.84.19-.25.37-.96 1.21-1.17 1.45-.22.25-.43.28-.8.09-.37-.19-1.57-.58-2.99-1.84-1.1-.99-1.85-2.2-2.07-2.57-.22-.37-.02-.57.16-.76.17-.17.37-.43.56-.65.19-.22.25-.37.37-.62.12-.25.06-.47-.03-.65-.09-.19-.84-2.02-1.15-2.76-.3-.72-.61-.62-.84-.63-.22-.01-.46-.01-.71-.01s-.65.09-.99.47c-.34.37-1.3 1.27-1.3 3.1 0 1.83 1.33 3.59 1.52 3.84.19.25 2.62 4 6.35 5.61.89.38 1.58.61 2.12.78.89.28 1.7.24 2.34.15.71-.11 2.2-.9 2.51-1.77.31-.87.31-1.61.22-1.77-.09-.15-.34-.25-.71-.43z"/>
                <path d="M15 1C7.28 1 1 7.28 1 15c0 2.59.72 5.01 1.97 7.07L1.1 28.13l6.29-1.93A13.93 13.93 0 0015 29c7.72 0 14-6.28 14-14S22.72 1 15 1zm0 25c-2.26 0-4.37-.62-6.17-1.7l-.44-.26-3.73 1.15 1.17-3.63-.28-.44A11.16 11.16 0 013.75 15C3.75 8.54 8.54 3.75 15 3.75S26.25 8.54 26.25 15 21.46 26.25 15 26.25z"/>
            </svg>
        </a>
    </div>

    <!-- Right col: 730x682 | each open item gets white bg -->
    <div class="w-full lg:w-[730px] flex flex-col gap-2">
        {faqs.map((faq, i) => (
            <div
                class={`rounded-[10px] transition-colors duration-300 ${i === 0 ? 'bg-white' : ''}`}
                data-faq-item={i}
            >
                <!-- Question row: px-8 py-8 | 730x96 per closed item -->
                <button
                    class="w-full flex items-center justify-between px-8 py-8 text-left cursor-pointer"
                    data-faq-btn={i}
                >
                    <!-- Question: Geist 24px/600 lh:30 ls:-0.5 -->
                    <span
                        class={`text-[24px] font-semibold leading-[30px] tracking-[-0.5px] pr-6 transition-colors duration-200 ${i === 0 ? 'text-[#1A1A1A]' : 'text-[#4E5663]'}`}
                        data-faq-label={i}
                    >
                        {faq.question}
                    </span>
                    <!-- Icon: 32x32 -->
                    <span class="shrink-0 w-8 h-8 flex items-center justify-center" data-faq-icon={i}>
                        {i === 0 ? (
                            <svg width="19" height="3" viewBox="0 0 19 3" fill="none">
                                <line x1="0" y1="1.5" x2="19" y2="1.5" stroke="#1A1A1A" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                        ) : (
                            <svg width="19" height="19" viewBox="0 0 19 19" fill="none">
                                <line x1="9.5" y1="0" x2="9.5" y2="19" stroke="#4E5663" stroke-width="2.5" stroke-linecap="round"/>
                                <line x1="0" y1="9.5" x2="19" y2="9.5" stroke="#4E5663" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                        )}
                    </span>
                </button>

                <!-- Answer: Geist 20px/500 #4E5663 lh:30 ls:-0.5 -->
                <div
                    class={`overflow-hidden transition-all duration-300 ${i === 0 ? 'max-h-96' : 'max-h-0'}`}
                    data-faq-body={i}
                >
                    <p class="text-[20px] font-medium leading-[30px] tracking-[-0.5px] text-[#4E5663] px-8 pb-8">
                        {faq.answer}
                    </p>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    const MINUS = `<svg width="19" height="3" viewBox="0 0 19 3" fill="none"><line x1="0" y1="1.5" x2="19" y2="1.5" stroke="#1A1A1A" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    const PLUS = `<svg width="19" height="19" viewBox="0 0 19 19" fill="none"><line x1="9.5" y1="0" x2="9.5" y2="19" stroke="#4E5663" stroke-width="2.5" stroke-linecap="round"/><line x1="0" y1="9.5" x2="19" y2="9.5" stroke="#4E5663" stroke-width="2.5" stroke-linecap="round"/></svg>`;

    let openIndex: number | null = 0;

    document.querySelectorAll("[data-faq-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const idx = parseInt((btn as HTMLElement).dataset.faqBtn!);

            // Close previously open item
            if (openIndex !== null && openIndex !== idx) {
                const prevItem = document.querySelector(`[data-faq-item="${openIndex}"]`);
                const prevBody = document.querySelector(`[data-faq-body="${openIndex}"]`);
                const prevLabel = document.querySelector(`[data-faq-label="${openIndex}"]`);
                const prevIcon = document.querySelector(`[data-faq-icon="${openIndex}"]`);
                prevItem?.classList.remove("bg-white");
                prevBody?.classList.replace("max-h-96", "max-h-0");
                prevLabel?.classList.replace("text-[#1A1A1A]", "text-[#4E5663]");
                if (prevIcon) prevIcon.innerHTML = PLUS;
            }

            // Toggle clicked item
            if (openIndex === idx) {
                // Close it
                const item = document.querySelector(`[data-faq-item="${idx}"]`);
                const body = document.querySelector(`[data-faq-body="${idx}"]`);
                const label = document.querySelector(`[data-faq-label="${idx}"]`);
                const icon = document.querySelector(`[data-faq-icon="${idx}"]`);
                item?.classList.remove("bg-white");
                body?.classList.replace("max-h-96", "max-h-0");
                label?.classList.replace("text-[#1A1A1A]", "text-[#4E5663]");
                if (icon) icon.innerHTML = PLUS;
                openIndex = null;
            } else {
                // Open it
                const item = document.querySelector(`[data-faq-item="${idx}"]`);
                const body = document.querySelector(`[data-faq-body="${idx}"]`);
                const label = document.querySelector(`[data-faq-label="${idx}"]`);
                const icon = document.querySelector(`[data-faq-icon="${idx}"]`);
                item?.classList.add("bg-white");
                body?.classList.replace("max-h-0", "max-h-96");
                label?.classList.replace("text-[#4E5663]", "text-[#1A1A1A]");
                if (icon) icon.innerHTML = MINUS;
                openIndex = idx;
            }
        });
    });
</script>
