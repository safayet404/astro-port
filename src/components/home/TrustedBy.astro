---
// Portfolio.astro
const logos = [
    { src: "/epay.png", alt: "Epay" },
    { src: "/b2.png", alt: "Niro" },
    { src: "/b3.png", alt: "Logoipsum" },
    { src: "/b4.png", alt: "Loco" },
    { src: "/b5.png", alt: "Bogo" },
    { src: "/b6.png", alt: "Logoipsum 2" },
];
---

<section id="portfolio" class="px-4 py-10 bg-[#F2F2F2] font-sans">
    <div class="container mx-auto max-w-6xl">
        <!-- Project Images Grid -->
        <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 w-full"
        >
            <img
                class="rounded-2xl w-full h-64 sm:h-72 lg:h-80 object-cover"
                src="/1.png"
                alt="Luxury Dream Home project"
                loading="lazy"
            />
            <img
                class="rounded-2xl w-full h-64 sm:h-72 lg:h-80 object-cover"
                src="/2.png"
                alt="Healthcare Website project"
                loading="lazy"
            />
            <img
                class="rounded-2xl w-full h-64 sm:h-72 lg:h-80 object-cover sm:col-span-2 lg:col-span-1"
                src="/3.png"
                alt="Finance App project"
                loading="lazy"
            />
        </div>

        <!-- Trusted By Marquee -->
        <div class="mt-10 flex items-center gap-6">
            <p class="text-[#1A1A1A] font-bold text-base flex-shrink-0">
                Trusted by:
            </p>

            <!-- Marquee wrapper -->
            <div class="overflow-hidden flex-1 relative">
                <!-- Fade edges -->
                <div
                    class="absolute left-0 top-0 h-full w-12 bg-gradient-to-r from-[#F2F2F2] to-transparent z-10 pointer-events-none"
                >
                </div>
                <div
                    class="absolute right-0 top-0 h-full w-12 bg-gradient-to-l from-[#F2F2F2] to-transparent z-10 pointer-events-none"
                >
                </div>

                <div class="marquee-track flex items-center gap-10 w-max">
                    <!-- Render logos twice for seamless loop -->
                    {
                        [...logos, ...logos].map((logo, i) => (
                            <img
                                src={logo.src}
                                alt={logo.alt}
                                class="h-14 object-contain grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-200 flex-shrink-0"
                                loading="lazy"
                                onerror="this.style.display='none'"
                            />
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- CTA + Description -->
        <div
            class="mt-10 flex flex-col sm:flex-row justify-center items-center gap-6"
        >
            <a
                href="#work"
                class="flex-shrink-0 inline-flex items-center gap-2 px-8 py-3 rounded-full border border-gray-400 text-[#1A1A1A] font-semibold text-sm hover:bg-[#1A1A1A] hover:text-white transition-colors duration-200"
            >
                View more Work
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 -rotate-45"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>
            <p
                class="text-gray-500 text-sm sm:text-base leading-relaxed text-center sm:text-left"
            >
                I help brands, founders, and small teams craft <br />
                <span class="text-[#1A1A1A] font-semibold"
                    >beautiful and impactful</span
                >
                digital experiences
            </p>
        </div>
    </div>
</section>

<style>
    .marquee-track {
        animation: marquee 18s linear infinite;
    }

    .marquee-track:hover {
        animation-play-state: paused;
    }

    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>
