---
const leftServices = ["Web Design", "Apps Design", "SaaS Design"];
const rightServices = ["Ecommerce", "Prototyping", "Wireframe"];
---

<!-- IMPACT: 1920x877 | VERTICAL gap:40 | pad T:50 R:370 B:50 L:370 | align:CENTER -->
<section id="results" class="w-full py-[50px] px-6 2xl:px-[370px] flex flex-col items-center gap-10">

    <!-- Header: VERTICAL gap:10 | centered -->
    <div class="flex flex-col items-center gap-[10px] text-center">
        <!-- Badge: stroke:#BDC1C7 1px | Geist 16px/500 #4E5663 | pad T:10 R:16 B:10 L:16 | radius:100 -->
        <div class="inline-flex border border-[#BDC1C7] rounded-full py-[10px] px-4">
            <span class="text-[16px] font-medium leading-[20.8px] text-[#4E5663]">Expertise</span>
        </div>
        <!-- Geist 50px/700 #1A1A1A lh:65 ls:-2 -->
        <h2 class="text-[40px] lg:text-[50px] font-bold leading-[65px] tracking-[-2px] text-[#1A1A1A]">Impactful Results</h2>
    </div>

    <!-- Bento grid: 1180x632 | HORIZONTAL gap:16 | SPACE_BETWEEN -->
    <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-4">

        <!-- Left col: VERTICAL gap:16 -->
        <div class="flex flex-col gap-4">

            <!-- Card 1: gradient #A1ECFF->#FFFFFF | radius:10 | pad:32 -->
            <div class="rounded-[10px] p-8 flex flex-col gap-6 border-2 border-white"
                 style="background: linear-gradient(180deg, #A1ECFF 0%, #FFFFFF 100%);">
                <!-- Avatars row: 50x50 overlap -4px -->
                <div class="flex items-center">
                    <div class="flex -space-x-1">
                        {[0,1,2,3].map(() => (
                            <div class="w-[50px] h-[50px] rounded-full bg-gray-300 border-2 border-white overflow-hidden">
                                <img src="/t1.png" alt="" class="w-full h-full object-cover" onerror="this.style.display='none'" />
                            </div>
                        ))}
                    </div>
                    <!-- 04+ badge: bg:#2966F4 | Geist 20px/600 #FFFFFF lh:26 ls:-1 -->
                    <div class="w-[54px] h-[54px] rounded-full bg-[#2966F4] flex items-center justify-center ml-[-4px] border-2 border-white">
                        <span class="text-[20px] font-semibold leading-[26px] tracking-[-1px] text-white">04+</span>
                    </div>
                </div>
                <!-- Text: Geist 24px/600 #1A1A1A lh:31.2 ls:-1 -->
                <div class="flex flex-col gap-2">
                    <h3 class="text-[24px] font-semibold leading-[31.2px] tracking-[-1px] text-[#1A1A1A]">04+ Creative Minds</h3>
                    <!-- Geist 18px/500 #4E5663 lh:23.4 ls:-0.5 -->
                    <p class="text-[18px] font-medium leading-[23.4px] tracking-[-0.5px] text-[#4E5663]">
                        Over the past 6+ years, I've worked with creators, startups, and
                    </p>
                </div>
            </div>

            <!-- Card 2: gradient #F2FFBE->#FFFFFF | radius:10 | pad:32 -->
            <div class="rounded-[10px] p-8 flex flex-col justify-center gap-4 border-2 border-white"
                 style="background: linear-gradient(180deg, #F2FFBE 0%, #FFFFFF 100%);">
                {leftServices.map((service, i) => (
                    <div class={`flex items-center gap-[5px] ${i === 1 ? 'justify-end' : 'justify-start'}`}>
                        {i !== 1 && (
                            <div class="w-[40px] h-[48px] rounded-full border border-[#4E5663] flex items-center justify-center shrink-0">
                                <svg width="14" height="19" viewBox="0 0 14 19" fill="none">
                                    <path d="M7 1v11M7 1L1 7M7 1l6 6M1 18h12" stroke="#4E5663" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        )}
                        <!-- Geist 18px/500 #1A1A1A lh:23.4 | rounded pill -->
                        <div class={`px-5 py-[10px] rounded-full border text-[18px] font-medium leading-[23.4px] text-[#1A1A1A] ${i === 1 ? 'bg-white border-[#989898]/50' : 'border-[#4E5663]'}`}>
                            {service}
                        </div>
                        {i === 1 && (
                            <div class="w-[40px] h-[48px] rounded-full bg-white border border-[#989898]/50 flex items-center justify-center shrink-0">
                                <svg width="14" height="19" viewBox="0 0 14 19" fill="none">
                                    <path d="M7 1v11M7 1L1 7M7 1l6 6M1 18h12" stroke="#4E5663" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        )}
                    </div>
                ))}
            </div>
        </div>

        <!-- Center col: video fill (scaleMode=STRETCH, top-left) + gradient overlay | radius:10 -->
        <div class="rounded-[10px] relative overflow-hidden min-h-[400px] lg:min-h-0 self-stretch">
            <!-- Background video — fills card from top-left (matches Figma scaleMode=STRETCH) -->
            <video
                class="absolute inset-0 w-full h-full object-cover object-left-top"
                autoplay
                muted
                loop
                playsinline
            >
                <source src="/video.mp4" type="video/mp4" />
            </video>
            <!-- Gradient overlay: transparent #2966F4 → solid #2966F4 (top to bottom) -->
            <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(41,102,244,0) 0%, #2966F4 100%);"></div>
            <!-- Text pinned to bottom-left -->
            <div class="absolute bottom-0 left-0 right-0 p-8 flex flex-col gap-2">
                <!-- Geist 30px/600 #FFFFFF lh:39 ls:-1 -->
                <h3 class="text-[30px] font-semibold leading-[39px] tracking-[-1px] text-white">150+ Global and Local Clients</h3>
                <!-- Geist 20px/500 #E6E6E6 lh:30 ls:-0.5 -->
                <p class="text-[20px] font-medium leading-[30px] tracking-[-0.5px] text-[#E6E6E6]">We ensure excellence for customer satisfaction.</p>
            </div>
        </div>

        <!-- Right col: VERTICAL gap:16 -->
        <div class="flex flex-col gap-4">

            <!-- Card 3: gradient #B4FFC3->#FFFFFF | radius:10 | pad:32 -->
            <div class="rounded-[10px] p-8 flex flex-col justify-between gap-6 border-2 border-white"
                 style="background: linear-gradient(180deg, #B4FFC3 0%, #FFFFFF 100%);">
                <div class="flex justify-end gap-3">
                    <div class="w-[60px] h-[60px] rounded-2xl bg-[#E2F4BA] border border-[#F5F8FF] flex items-center justify-center">
                        <span class="text-2xl">⭐</span>
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <!-- Geist 30px/600 #1A1A1A lh:39 ls:-1 -->
                    <h3 class="text-[30px] font-semibold leading-[39px] tracking-[-1px] text-[#1A1A1A]">4.9/4 Rating</h3>
                    <!-- Geist 20px/500 #4E5663 lh:30 ls:-0.5 -->
                    <p class="text-[20px] font-medium leading-[30px] tracking-[-0.5px] text-[#4E5663]">We ensure excellence for customer satisfaction.</p>
                </div>
            </div>

            <!-- Card 4: gradient #FFD1C5->#FFFFFF | radius:10 | pad:32 -->
            <div class="rounded-[10px] p-8 flex flex-col justify-center gap-4 border-2 border-white"
                 style="background: linear-gradient(180deg, #FFD1C5 0%, #FFFFFF 100%);">
                {rightServices.map((service, i) => (
                    <div class={`flex items-center gap-[5px] ${i === 1 ? 'justify-end' : 'justify-start'}`}>
                        {i !== 1 && (
                            <div class="w-[40px] h-[48px] rounded-full bg-white border border-[#989898]/50 flex items-center justify-center shrink-0">
                                <svg width="14" height="19" viewBox="0 0 14 19" fill="none">
                                    <path d="M7 1v11M7 1L1 7M7 1l6 6M1 18h12" stroke="#4E5663" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        )}
                        <div class={`px-5 py-[10px] rounded-full border text-[18px] font-medium leading-[23.4px] text-[#1A1A1A] ${i === 1 ? 'border-[#4E5663]' : 'bg-white border-[#989898]/50'}`}>
                            {service}
                        </div>
                        {i === 1 && (
                            <div class="w-[40px] h-[48px] rounded-full border border-[#4E5663] flex items-center justify-center shrink-0">
                                <svg width="14" height="19" viewBox="0 0 14 19" fill="none">
                                    <path d="M7 1v11M7 1L1 7M7 1l6 6M1 18h12" stroke="#1A1A1A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
