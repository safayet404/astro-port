---
// Services.astro
const services = [
    {
        number: "01",
        title: "UI/UX Design",
        items: [
            "UX UI Design",
            "UX UI Consulting",
            "UX Audit",
            "UX Research",
            "Wireframe & UI Prototyping",
            "Design System",
        ],
    },
    {
        number: "02",
        title: "Web Design",
        items: [
            "UX UI Design",
            "UX UI Consulting",
            "UX Audit",
            "UX Research",
            "Wireframe & UI Prototyping",
            "Design System",
        ],
    },
    {
        number: "03",
        title: "Mobile App Design",
        items: [
            "UX UI Design",
            "UX UI Consulting",
            "UX Audit",
            "UX Research",
            "Wireframe & UI Prototyping",
            "Design System",
        ],
    },
];
---

<section id="services" class="py-20 bg-[#F2F2F2] font-sans">
    <div class="container mx-auto px-6 max-w-6xl">
        <!-- Header -->
        <div class="mb-10">
            <span
                class="inline-block border border-gray-400 text-gray-600 text-sm px-4 py-1 rounded-full mb-4 tracking-wide"
            >
                Services
            </span>
            <h2
                class="text-4xl lg:text-5xl font-extrabold text-[#1A1A1A] leading-tight"
            >
                We Provides Services
            </h2>
        </div>

        <!-- Body: Two columns -->
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start">
            <!-- Left: Accordion List -->
            <div class="w-full lg:w-1/2 space-y-1">
                {
                    services.map((service, i) => (
                        <div
                            class={`rounded-2xl transition-all duration-300 overflow-hidden ${
                                i === 0
                                    ? "bg-white shadow-sm"
                                    : "bg-transparent border border-transparent hover:border-gray-200"
                            }`}
                        >
                            <button
                                class="w-full flex items-center justify-between px-6 py-5 text-left group"
                                aria-expanded={i === 0 ? "true" : "false"}
                                data-index={i}
                            >
                                <div class="flex items-center gap-4">
                                    <span class="text-sm text-gray-400 font-medium w-8">
                                        ({service.number})
                                    </span>
                                    <span
                                        class={`text-xl font-bold transition-colors ${
                                            i === 0
                                                ? "text-[#1A1A1A]"
                                                : "text-gray-500"
                                        }`}
                                    >
                                        {service.title}
                                    </span>
                                </div>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-5 h-5 text-gray-400 -rotate-45 flex-shrink-0"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M12 5l7 7-7 7"
                                    />
                                </svg>
                            </button>

                            {/* Sub-items (open by default for first) */}
                            {service.items.length > 0 && (
                                <ul
                                    class={`px-6 pb-6 space-y-3 ${i === 0 ? "block" : "hidden"}`}
                                    data-sub={i}
                                >
                                    {service.items.map((item) => (
                                        <li class="text-gray-500 text-base pl-12">
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    ))
                }
            </div>

            <!-- Right: Image -->
            <div class="w-full lg:w-1/2 flex justify-center items-center">
                <div
                    class="w-full max-w-sm rounded-3xl overflow-hidden bg-[#1A1A1A] aspect-[4/5] flex items-center justify-center shadow-xl"
                >
                    <img
                        src="/mobile.png"
                        alt="Service mockup"
                        class="w-full h-full object-cover rounded-3xl"
                        onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'text-white/20 text-center p-10\'><svg xmlns=\'http://www.w3.org/2000/svg\' class=\'w-24 h-24 mx-auto mb-4 opacity-30\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1\' d=\'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\'/></svg><p class=\'text-white/40 text-sm\'>mobile.png</p></div>'"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const buttons = document.querySelectorAll("[data-index]");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const idx = btn.getAttribute("data-index");
            const sub = document.querySelector(`[data-sub="${idx}"]`);
            const parentCard = btn.closest("div.rounded-2xl");
            const allCards = document.querySelectorAll("[data-index]");

            // Reset all
            allCards.forEach((b) => {
                const i = b.getAttribute("data-index");
                const s = document.querySelector(`[data-sub="${i}"]`);
                const card = b.closest("div.rounded-2xl");
                if (card) {
                    card.classList.remove("bg-white", "shadow-sm");
                    card.classList.add("bg-transparent");
                }
                if (s) s.classList.add("hidden");
                const label = b.querySelector(
                    "span:nth-child(2), div span:last-child",
                );
            });

            // Activate clicked
            if (parentCard) {
                parentCard.classList.add("bg-white", "shadow-sm");
                parentCard.classList.remove("bg-transparent");
            }
            if (sub) sub.classList.remove("hidden");
        });
    });
</script>
