---
const budgets = ["Less than $5k", "$5k - $10k", "More than $20k+"];
---

<!-- CONTACT: 1920x945 | pad T:50 R:370 B:50 L:370 | HORIZONTAL gap:88 | centered -->
<section
    id="contact"
    class="w-full py-[50px] px-6 2xl:px-[370px] flex flex-col lg:flex-row gap-10 lg:gap-[88px] items-start justify-center"
>
    <!-- Left col: 319x705 | VERTICAL gap:40 -->
    <div class="flex flex-col gap-10 w-full lg:max-w-[319px] shrink-0">
        <!-- Badge + Heading -->
        <div class="flex flex-col gap-[10px]">
            <!-- Badge: stroke:#BDC1C7 | Geist 16px/500 #4E5663 | radius:100 -->
            <div
                class="inline-flex self-start border border-[#BDC1C7] rounded-full py-1 px-4"
            >
                <span
                    class="text-[16px] font-medium leading-[20.8px] text-[#4E5663]"
                    >Contact Us</span
                >
            </div>
            <!-- Heading: Geist 50px/700 #1A1A1A lh:54 ls:-2 -->
            <h2
                class="text-[36px] lg:text-[50px] font-bold leading-[1.08] lg:leading-[54px] tracking-[-2px] text-[#1A1A1A]"
            >
                Let's Collaborate Together
            </h2>
        </div>

        <!-- Image: 283x283 radius:10 -->
        <div
            class="w-full lg:w-[283px] lg:h-[283px] rounded-[10px] overflow-hidden shrink-0"
        >
            <img
                src="/masjidul.png"
                alt="Masjidul"
                class="w-full h-full object-cover object-top"
            />
        </div>

        <!-- Contact info: VERTICAL gap:24 -->
        <div class="flex flex-col gap-6">
            <!-- "Directly Reach Out": Geist 20px/500 #1A1A1A ls:-0.5 -->
            <p
                class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-[#1A1A1A]"
            >
                Directly Reach Out
            </p>

            <!-- Gmail: label Geist 20px/400 #4E5663 ls:-1 | value Geist 24px/600 #1A1A1A lh:31.2 ls:-1 -->
            <div class="flex flex-col gap-1">
                <span
                    class="text-[20px] font-normal leading-[26px] tracking-[-1px] text-[#4E5663]"
                    >Gmail</span
                >
                <a
                    href="mailto:hellomasjidul@gmail.com"
                    class="text-[20px] lg:text-[24px] font-semibold leading-[31.2px] tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors break-all"
                >
                    hellomasjidul@gmail.com
                </a>
            </div>

            <!-- WhatsApp -->
            <div class="flex flex-col gap-1">
                <span
                    class="text-[20px] font-normal leading-[26px] tracking-[-1px] text-[#4E5663]"
                    >WhatsApp</span
                >
                <a
                    href="https://wa.me/8801875189361"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[24px] font-semibold leading-[31.2px] tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors"
                >
                    +88 018 7518 9361
                </a>
            </div>
        </div>
    </div>

    <!-- Right col: 584x841 | bg:#FFFFFF pad:16 radius:10 -->
    <div class="w-[584px] bg-white p-4">
        <!-- Inner dark card: bg:#1A1A1A radius:10 pad:40 -->
        <div class="bg-[#1A1A1A] rounded-[10px] p-8 lg:p-[40px]">
            <form class="flex flex-col gap-6" id="contact-form">
                <!-- Full Name: label Geist 20px/500 #FFFFFF ls:-0.5 -->
                <div class="flex flex-col gap-2">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                        >Full Name</label
                    >
                    <input
                        type="text"
                        name="name"
                        placeholder="Md. Masjidul Islam"
                        required
                        class="w-full px-5 py-4 bg-[#1A1A1A] border border-[#4E5663] rounded-[16px] text-[18px] font-medium leading-[23.4px] text-[#4E5663] placeholder-[#4E5663]/60 outline-none focus:border-white transition-colors"
                    />
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-2">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                        >Email</label
                    >
                    <input
                        type="email"
                        name="email"
                        placeholder="hello@example.com"
                        required
                        class="w-full px-5 py-4 bg-[#1A1A1A] border border-[#4E5663] rounded-[16px] text-[18px] font-medium leading-[23.4px] text-[#4E5663] placeholder-[#4E5663]/60 outline-none focus:border-white transition-colors"
                    />
                </div>

                <!-- Service -->
                <div class="flex flex-col gap-2">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                        >Service</label
                    >
                    <div class="relative">
                        <select
                            name="service"
                            class="w-full px-5 py-4 bg-[#1A1A1A] border border-[#4E5663] rounded-[16px] text-[18px] font-medium leading-[23.4px] text-[#4E5663] outline-none appearance-none cursor-pointer focus:border-white transition-colors"
                        >
                            <option value="">Select your service</option>
                            <option value="UI/UX Design">UI/UX Design</option>
                            <option value="Web Design">Web Design</option>
                            <option value="Mobile App Design"
                                >Mobile App Design</option
                            >
                            <option value="SaaS Design">SaaS Design</option>
                            <option value="E-commerce Design"
                                >E-commerce Design</option
                            >
                            <option value="Wireframing & Prototyping"
                                >Wireframing &amp; Prototyping</option
                            >
                        </select>
                        <div
                            class="pointer-events-none absolute right-5 top-1/2 -translate-y-1/2 text-[#4E5663]"
                        >
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                            >
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Current Website -->
                <div class="flex flex-col gap-2">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                    >
                        Current Website <span class="text-[#4E5663]"
                            >(Optional)</span
                        >
                    </label>
                    <input
                        type="url"
                        name="website"
                        placeholder="https://website.com"
                        class="w-full px-5 py-4 bg-[#1A1A1A] border border-[#4E5663] rounded-[16px] text-[18px] font-medium leading-[23.4px] text-[#4E5663] placeholder-[#4E5663]/60 outline-none focus:border-white transition-colors"
                    />
                </div>

                <!-- Project Budget: pills -->
                <div class="flex flex-col gap-3">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                        >Project Budget</label
                    >
                    <div class="flex flex-wrap gap-2" id="budget-group">
                        {
                            budgets.map((budget) => (
                                <button
                                    type="button"
                                    data-budget={budget}
                                    class="budget-btn px-5 py-[10px] rounded-full border border-[#4E5663] text-[18px] font-medium leading-[23.4px] text-[#4E5663] hover:border-white hover:text-white transition-all"
                                >
                                    {budget}
                                </button>
                            ))
                        }
                    </div>
                    <input type="hidden" name="budget" id="selected-budget" />
                </div>

                <!-- Project Details -->
                <div class="flex flex-col gap-2">
                    <label
                        class="text-[20px] font-medium leading-[26px] tracking-[-0.5px] text-white"
                        >Project Details</label
                    >
                    <textarea
                        name="details"
                        rows="4"
                        placeholder="Tell us more about your idea..."
                        class="w-full px-5 py-4 bg-[#1A1A1A] border border-[#4E5663] rounded-[16px] text-[18px] font-medium leading-[23.4px] text-[#4E5663] placeholder-[#4E5663]/60 outline-none focus:border-white transition-colors resize-none"
                    ></textarea>
                </div>

                <!-- Submit: bg:#2966F4 | radius:100 | h:64 | Geist 22px/500 -->
                <button
                    type="submit"
                    class="w-full flex items-center justify-center gap-2 bg-[#2966F4] text-white rounded-full py-[10px] px-5 text-[22px] font-medium leading-[28.6px] hover:bg-[#1d50d4] transition-colors"
                    style="height:64px;"
                >
                    Send Message
                    <svg
                        width="26"
                        height="26"
                        viewBox="0 0 26 26"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g clip-path="url(#clip0_1_515)">
                            <path
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                                d="M19.6947 4.7735C19.6977 4.77044 19.7009 4.7673 19.704 4.76424L21.2361 6.29638L21.2041 6.3284C17.5456 10.0171 17.7315 15.0483 20.087 17.4038L18.5549 18.9358C16.6397 17.0207 15.8666 14.127 16.3457 11.1868L6.29846 21.234L4.7664 19.7019L14.8138 9.65459C11.8735 10.1337 8.97959 9.36052 7.06442 7.44535L8.59648 5.91328C10.9568 8.27357 16.004 8.45544 19.6947 4.7735Z"
                                fill="white"></path>
                        </g>
                        <defs>
                            <clipPath id="clip0_1_515">
                                <rect width="26" height="26" fill="white"
                                ></rect>
                            </clipPath>
                        </defs>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</section>

<script>
    const budgetBtns = document.querySelectorAll(".budget-btn");
    const selectedBudget = document.getElementById(
        "selected-budget",
    ) as HTMLInputElement;

    budgetBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            budgetBtns.forEach((b) => {
                b.classList.remove("border-white", "text-white");
                b.classList.add("border-[#4E5663]", "text-[#4E5663]");
            });
            btn.classList.remove("border-[#4E5663]", "text-[#4E5663]");
            btn.classList.add("border-white", "text-white");
            if (selectedBudget)
                selectedBudget.value =
                    (btn as HTMLElement).dataset.budget || "";
        });
    });

    const form = document.getElementById("contact-form") as HTMLFormElement;
    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        console.log("Form submitted:", Object.fromEntries(data));
    });
</script>
