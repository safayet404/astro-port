---
const navLinks = [
    { label: "About", href: "#about" },
    { label: "Works", href: "#projects" },
    { label: "Services", href: "#services" },
    { label: "Results", href: "#results" },
    { label: "Contact", href: "#contact" },
];

const socialLinks = [
    { label: "LinkedIn", href: "https://linkedin.com" },
    { label: "X / Twitter", href: "https://twitter.com" },
    { label: "Instagram", href: "https://instagram.com" },
    { label: "Facebook", href: "https://facebook.com" },
];
---

<!-- FOOTER: 1920x349 | pad T:50 R:370 B:50 L:370 -->
<footer class="w-full wrap">
    <!-- Inner white card: bg:#FFFFFF | radius:10 | pad T:40 R:60 B:40 L:60 | HORIZONTAL gap:75 | SPACE_BETWEEN -->
    <div
        class="w-full bg-white py-10 px-6 lg:px-15 flex flex-col lg:flex-row items-start justify-between gap-10 lg:gap-18.75"
    >
        <!-- Contact col -->
        <div class="flex flex-col gap-6" data-aos="fade-right">
            <!-- "Contact": Geist 18px/400 #1A1A1A -->
            <span
                class="text-[18px] font-normal leading-[23.4px] text-[#1A1A1A]"
                >Contact</span
            >
            <!-- Description: Geist 20px/500 #4E5663 lh:26 -->
            <p class="text-[20px] font-medium leading-6.5 text-[#4E5663]">
                You contact me directly via <a
                    href="https://wa.me/8801875189361"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-[#2966F4] transition-colors"
                    >WhatsApp</a
                > or <a
                    href="mailto:masjidulislam678@gmail.com"
                    class="underline hover:text-[#2966F4] transition-colors"
                    >Email</a
                >.
            </p>
            <!-- Gmail: label Geist 18px/400 #1A1A1A ls:-1 | value Geist 30px/600 #1A1A1A lh:39 ls:-1 -->
            <div class="flex flex-col gap-1">
                <span
                    class="text-[18px] font-normal leading-[23.4px] tracking-[-1px] text-[#1A1A1A]"
                    >Gmail</span
                >
                <a
                    href="mailto:masjidulislam678@gmail.com"
                    class="text-[22px] lg:text-[30px] font-semibold leading-9.75 tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors break-all"
                >
                    masjidulislam678@gmail.com
                </a>
            </div>
            <!-- WhatsApp -->
            <div class="flex flex-col gap-1">
                <span
                    class="text-[18px] font-normal leading-[23.4px] tracking-[-1px] text-[#1A1A1A]"
                    >WhatsApp</span
                >
                <a
                    href="https://wa.me/8801875189361"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[30px] font-semibold leading-9.75 tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors"
                >
                    +88 018 7518 9361
                </a>
            </div>
        </div>

        <!-- Nav col: "(Explor)" 18px/400 UPPER | links 29px/600 lh:37.7 ls:-1 -->
        <div class="flex flex-col gap-4" data-aos="fade-up" data-aos-delay="100">
            <span
                class="text-[18px] font-normal leading-[23.4px] text-[#1A1A1A] uppercase"
                >(Explor)</span
            >
            <nav class="flex flex-col gap-1">
                {
                    navLinks.map((link) => (
                        <a
                            href={link.href}
                            class="text-[29px] font-semibold leading-[37.7px] tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </nav>
        </div>

        <!-- Social col: "(Social)" 18px/400 UPPER | links 30px/600 lh:39 ls:-1 -->
        <div class="flex flex-col gap-4" data-aos="fade-left" data-aos-delay="200">
            <span
                class="text-[18px] font-normal leading-[23.4px] text-[#1A1A1A] uppercase"
                >(Social)</span
            >
            <nav class="flex flex-col gap-1">
                {
                    socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[30px] font-semibold leading-9.75 tracking-[-1px] text-[#1A1A1A] hover:text-[#2966F4] transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</footer>
